# 한국마사회(KRA) Open API 서비스 키 — data.go.kr에서 발급
# 반드시 "Decoding"(원본) 키를 사용할 것. URL-Encoding 키를 넣으면 이중 인코딩으로 인증 실패.
# 서버 전용 값 — 절대 NEXT_PUBLIC_ 접두사를 붙이지 말 것.
KRA_SERVICE_KEY=

# Web Push (VAPID) — `npx web-push generate-vapid-keys`로 생성
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# 푸시 서비스에 전달되는 발신자 연락처 (mailto: 형식)
VAPID_SUBJECT=

# Vercel Cron 인증용 임의 시크릿 — Vercel이 크론 호출 시 Authorization: Bearer로 전달
CRON_SECRET=

# Upstash Redis (푸시 구독 저장) — Vercel Marketplace 설치 시 자동 주입
# (UPSTASH_REDIS_REST_URL/TOKEN 또는 KV_REST_API_URL/TOKEN 계열)
